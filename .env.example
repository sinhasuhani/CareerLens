# GEMINI_API_KEY: Required for Gemini AI and LangChain API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# Model selection for CareerLens analysis (default: gemini-1.5-flash)
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"

# Python RAG FastAPI Service URL (default: http://127.0.0.1:8000)
RAG_SERVICE_URL="http://127.0.0.1:8000"

# Application URL
APP_URL="http://localhost:3000"
PORT=3000
